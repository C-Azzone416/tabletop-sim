# Neon Postgres connection string
# Create a dev branch in Neon dashboard: Project → Branches → Create Branch
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server port (default: 3001)
PORT=3001

# Pre-launch access gate (#252) — see docs/access-control.md. Leave both
# blank for local dev (gate disabled); REQUIRED in production, or the server
# refuses to start. Must match the client's NEXT_PUBLIC_API_ACCESS_KEY.
# API_ACCESS_KEY=
# PROFILE_ALLOWLIST=
