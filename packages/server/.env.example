# Neon Postgres connection string
# Create a dev branch in Neon dashboard: Project → Branches → Create Branch
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server port (default: 3001)
PORT=3001

# Pre-launch access gate (#252) — see docs/access-control.md. Leave both
# blank for local dev (gate disabled); REQUIRED in production, or the server
# refuses to start. Must match the client's NEXT_PUBLIC_API_ACCESS_KEY.
# API_ACCESS_KEY=
# PROFILE_ALLOWLIST=

# POST /profiles per-IP rate limit (#264) — optional, defaults to 20
# requests/minute if unset. Only worth changing if real traffic needs a
# different threshold.
# PROFILES_RATE_LIMIT_MAX=20
# PROFILES_RATE_LIMIT_WINDOW_MS=60000

# Comma-separated allowed CORS origins for the client. Optional — omitting
# it does NOT open the allowlist; it falls back to exactly
# http://localhost:3000 (fine for local dev, but means every other origin,
# including a real deployed client, is rejected until this is set).
# CORS_ORIGINS=http://localhost:3000

# Pino log level. Optional, defaults to 'info' if unset.
# LOG_LEVEL=info

# Gates /dev/* routes (seed/cleanup/reveal tooling). Also requires
# NODE_ENV !== 'production' — belt-and-braces, not the only guard. Optional,
# defaults to routes disabled if unset.
# ENABLE_DEV_SEED=true
