# Server URL for WebSocket and API connections
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET=your-secret-here

# Dev tools (never commit .env.local with this set)
# NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# Pre-launch access gate (#252) — see docs/access-control.md. Must match the
# server's API_ACCESS_KEY. Leave blank for local dev (gate disabled). This
# ships in the browser bundle by necessity (WS/fetch calls send it directly);
# it's a coarse pre-launch bouncer, not a secret hidden from the browser.
# NEXT_PUBLIC_API_ACCESS_KEY=
